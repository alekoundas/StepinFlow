# The rules this codebase is held to, and every place it departs from the defaults with the reason written next to it. 
#
# Severity: none | silent | suggestion | warning | error

root = true

[*.cs]

# ----------------------------------------------------------------------------------------------
# Naming
# ----------------------------------------------------------------------------------------------

# CA1707 "identifiers should not contain underscores" (ex. enums)
dotnet_diagnostic.CA1707.severity = none

# CA1711 "identifiers should not have incorrect suffix" (force inheritance by class name suffix)
dotnet_diagnostic.CA1711.severity = none

# CA1725 "Parameter names should match base declaration" (param names must match interface params)
dotnet_diagnostic.CA1725.severity = warning

# CA1848 "Use the LoggerMessage delegates" (Microsoft recommends using the LoggerMessage pattern to optimize high-performance logging)
dotnet_diagnostic.CA1848.severity = none

#CA1716 "Identifiers should not match keywords" (Keywords from VB as well)
dotnet_diagnostic.CA1716.severity = none

#CA1051 "Do not declare visible instance fields" (Intefaces never expose fields only properties)
dotnet_diagnostic.CA1051.severity = error

#CA1720 "Identifiers should not contain type names" (Keywords from VB as well)
dotnet_diagnostic.CA1720.severity = none

# IDE0130 "Namespace does not match folder structure" (Dont force files to use the literal namespace - allow import grouping)
dotnet_diagnostic.IDE0130.severity = none

# ----------------------------------------------------------------------------------------------
# Performance
# ----------------------------------------------------------------------------------------------

#CA1859 "Use concrete types when possible for improved performance" (Using interfaces like IEnumerable<string> causes runtime performance cost, use for example ICollection or List )
dotnet_diagnostic.CA1859.severity = suggestion

#CA1861 "Avoid constant arrays as arguments" (.NET runtime is forced to allocate a brand-new array on the heap every single time that line of code executes)
dotnet_diagnostic.CA1861.severity = suggestion

#CA1000 "Do not declare static members on generic types" (Generic classes shouldnt have a static method because it gets ccoppied for every type (int,string etc) )
dotnet_diagnostic.CA1000.severity = suggestion

# "Collection initialization can be simplified" (LinQ chaining a ".ToList()" at the end is worst than spreadinng "[.. query.Where()]"
dotnet_diagnostic.IDE0305.severity = suggestion

# SYSLIB1054 "Use LibraryImport instead of DllImport" (ONLY for Platform.Windows proj)
# Compile and generate source code for the marshalling of data transfer between C# and C++
dotnet_diagnostic.SYSLIB1054.severity = suggestion


# ----------------------------------------------------------------------------------------------
# Culture
# ----------------------------------------------------------------------------------------------

#CA1305 "Specify IFormatProvider" Culture-sensitive formatting.
dotnet_diagnostic.CA1305.severity = warning


# ----------------------------------------------------------------------------------------------
# House coding style
# ----------------------------------------------------------------------------------------------

# The full new TypeName(), never new().
csharp_style_implicit_object_creation_when_type_is_apparent = false:suggestion

# No expression-bodied members. (no arrows allowed)
csharp_style_expression_bodied_methods = false:suggestion
csharp_style_expression_bodied_properties = false:suggestion
csharp_style_expression_bodied_indexers = false:suggestion
csharp_style_expression_bodied_accessors = false:suggestion

#IDE0290 "Use primary constructor" (Dont warn to use class like: public ClassName(int param){...} )
dotnet_diagnostic.IDE0290.severity = none

#IDE0066 "Use 'switch' expression"
dotnet_diagnostic.IDE0066.severity = none 
            
# IDE0028 "Collection initialization can be simplified" (Allow the "new" keyword ex. List<string> names = new List<string>())  
dotnet_diagnostic.IDE0028.severity = none 


#IDE0005 "Using directive is unnecessary" (A dead "using" is not accepted)
dotnet_diagnostic.IDE0005.severity = warning
#CS1591 "Missing XML comment for publicly visible type or member" - required after IDE0005 (a public class or property without a comment "///")
dotnet_diagnostic.CS1591.severity = none



# ----------------------------------------------------------------------------------------------
# Project specific
# ----------------------------------------------------------------------------------------------


#IDE0005 "Using directive is unnecessary" (A dead "using" is accepted ONLY in migrations)
# EF writes a migration "usings" from a template and does not know which the migration uses.
[DataAccess/Migrations/**.cs]
dotnet_diagnostic.IDE0005.severity = none






#TODO 
#CA1305 "Specify IFormatProvider" Culture-sensitive formatting.
# A number written into a .sflw file on a machine whose decimal separator is a comma is a file the
# parser cannot read back. The writer already formats invariantly; this is what keeps the next one doing it.
#[Business/FlowScript/**.cs]
#dotnet_diagnostic.CA1305.severity = warning









#RS0030 "The symbol is banned in this project" (backend/Rules/BannedSymbols.txt)
# CommandRunner is the deviation, and a port would not fix it: BuildStartInfo launches cmd.exe or
# powershell.exe and reads the console OEM code page, and every CommandPresetCatalog entry is a
# Windows command. The question is whether the runner moves to Platform.Windows whole - see PLAN.md
# phase 4.6. Until it is answered this is the one place Business may hold a Process.
[Business/Command/**.cs]
dotnet_diagnostic.RS0030.severity = none


