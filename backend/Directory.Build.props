<Project>

  <!--
    Directory.Build.props is MSBuild. 
    Its imported into every .csproj beneath it.
    It runs at project evaluation — before the compiler is even invoked. 
    It sets project-level properties: whether analyzers run at all, which analysis level, whether warnings are errors, what packages get referenced.
    
  -->
  <PropertyGroup>
    
    <!-- Analyzers -->
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-recommended</AnalysisLevel>

    <!-- Actually enforce .editorconfig file preferences at compile (IDE rules are editor-only by default. ) -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

    <!-- Force ALL warnings to behave as compile errors-->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <!-- Except from the security warninngs of:
          NU1901 - Low
          NU1902 - Moderate
          NU1903 - High
          NU1904 - Critical-->
    <WarningsNotAsErrors>NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>

    <!-- Required for the IDE0005(dead usings) rule to work, by setting it to "true" you tell the compiler: 
         "I want to generate a complete metadata map of my public code to expose to external systems."-->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- BannedApiAnalyzers -->
  <!-- Closest to MISRA rules. Two lists, one rule for Platform.Windows and a global one for the others. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="4.14.0" PrivateAssets="all" />
  </ItemGroup>

  <!-- Everything except Platform.Windows. -->
  <ItemGroup Condition="$(MSBuildProjectName) != 'Platform.Windows'">
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)BannedSymbols.txt" Visible="false" />
  </ItemGroup>

  <!-- Platform.Windows ONLY. -->
  <ItemGroup Condition="$(MSBuildProjectName) == 'Platform.Windows'">
    <AdditionalFiles Include="BannedSymbols.txt" />
  </ItemGroup>

  <!-- Test projects ONLY -->
  <PropertyGroup Condition="$(MSBuildProjectName.EndsWith('.Tests'))">
    <!-- xUnit v3: every test project is its own executable. -->
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- xUnit generates Main and blocks on a Task in it - right there, since nothing above Main can
         await. This switch silences warnings in that generated file and nowhere else. -->
    <DefineConstants>$(DefineConstants);XUNIT_GENERATED_DISABLE_WARNINGS</DefineConstants>

    <!-- Exit code 8 is "no tests ran". A project with none yet, or one whose tests are all filtered
         out - the desktop-only ones in a headless run - is not a failure. -->
    <TestingPlatformCommandLineArguments>$(TestingPlatformCommandLineArguments) --ignore-exit-code 8</TestingPlatformCommandLineArguments>
  </PropertyGroup>

  <ItemGroup Condition="$(MSBuildProjectName.EndsWith('.Tests'))">
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="xunit.v3" Version="4.0.1" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0" PrivateAssets="all" />
    <PackageReference Include="Shouldly" Version="4.3.0" />
    <!-- coverlet.collector is VSTest only; this is coverlet for the test platform dotnet test uses now. -->
    <PackageReference Include="coverlet.MTP" Version="10.0.1" PrivateAssets="all" />

    <Using Include="Xunit" />
    <Using Include="Shouldly" />
  </ItemGroup>

</Project>
