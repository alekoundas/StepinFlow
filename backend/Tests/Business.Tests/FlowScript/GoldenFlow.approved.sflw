Description:
  # Every step, every mode and every field, with a value and without one. It reads, and executing it would mean nothing.
  #
  # Imported into a real database and exported again, it comes back character for character.
  #
  # # not a heading
  # ## nor a stage
  # <[ quotes ]> are only text here.

