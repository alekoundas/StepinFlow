<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="AiDocs\**\*.md" />
  </ItemGroup>

  <!-- Downloaded by "npm run model:download" into AiModels/, which is gitignored. Content
       rather than EmbeddedResource: it stays a loose file beside the exe, which single file
       publish leaves alone. -->
  <ItemGroup>
    <Content Include="AiModels\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MediatR" Version="14.2.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="protobuf-net" Version="3.4.21" />
  </ItemGroup>

</Project>
