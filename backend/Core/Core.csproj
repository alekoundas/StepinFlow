<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- Required for the IDE0005(dead usings) rule to work, by setting it to "true" you tell the compiler: 
         "I want to generate a complete metadata map of my public code to expose to external systems."-->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="AiDocuments\**\*.md" />
  </ItemGroup>

  <!-- Downloaded by "npm run model:download" into AiModels/, which is gitignored. Content
       rather than EmbeddedResource: it stays a loose file beside the exe, which single file
       publish leaves alone. -->
  <ItemGroup>
    <Content Include="AiModels\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
