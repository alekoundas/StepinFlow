<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="AiDocuments\**\*.md" />
  </ItemGroup>

  <!-- The text embedder, the element detector and the built-in OCR, downloaded by "npm run models" into AiModels/, which is gitignored. 
       Content rather than EmbeddedResource: it stays a loose file beside the exe, which single file publish leaves alone. -->
  <ItemGroup>
    <Content Include="AiModels\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
