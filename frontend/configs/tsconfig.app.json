// Config for React source code
{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "types": ["vite/client"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true, // Forcces you to add "type" keyword on imports
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Path alias — no "baseUrl" (deprecated in TS 6, removed in TS 7).
       Without it, "paths" targets resolve relative to this file's folder. */
    "paths": {
      "@/*": ["../src/*"]
    },

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true, //bans any TypeScript syntax that generates runtime JavaScript code
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  },
  "include": [
    "../src",
    "../electron/shared/types.ts",
    "../electron/shared/channels.ts",
    "../electron/preload.d.ts",
    "../electron/preload.ts"
  ]
}
